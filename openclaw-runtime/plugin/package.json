{
  "name": "@verntrip/openclaw-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "VernTrip tools and runtime integration for OpenClaw.",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/workspace-tool.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "typebox": "1.1.39"
  },
  "bundledDependencies": [
    "typebox"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.7.1",
    "typescript": "^5.9.0"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1",
      "pluginSdkVersion": "2026.7.1"
    }
  }
}

[
  {
    "path": "gateway.mode",
    "value": "local"
  },
  {
    "path": "gateway.bind",
    "value": "loopback"
  },
  {
    "path": "gateway.auth.mode",
    "value": "token"
  },
  {
    "path": "gateway.controlUi.allowedOrigins",
    "value": [
      "http://localhost:18789",
      "http://127.0.0.1:18789"
    ]
  },
  {
    "path": "gateway.http.endpoints.responses.enabled",
    "value": true
  },
  {
    "path": "gateway.http.endpoints.responses.files.allowUrl",
    "value": false
  },
  {
    "path": "gateway.http.endpoints.responses.images.allowUrl",
    "value": false
  },
  {
    "path": "plugins.allow",
    "value": [
      "verntrip"
    ]
  },
  {
    "path": "plugins.entries.verntrip",
    "value": {
      "enabled": true,
      "config": {
        "backendBaseUrl": "http://127.0.0.1:8080",
        "requestTimeoutMs": 30000,
        "serviceTokenEnv": "VERNTRIP_OPENCLAW_SERVICE_TOKEN"
      }
    }
  },
  {
    "path": "skills.entries[\"verntrip-foundation\"]",
    "value": {
      "enabled": true
    }
  },
  {
    "path": "agents.defaults.skills",
    "value": [
      "verntrip-foundation"
    ]
  },
  {
    "path": "models.providers.verntrip-deepseek",
    "value": {
      "baseUrl": "https://api.deepseek.com",
      "api": "openai-completions",
      "apiKey": {
        "source": "env",
        "provider": "default",
        "id": "DEEPSEEK_API_KEY"
      },
      "models": [
        {
          "id": "deepseek-chat",
          "name": "DeepSeek Chat",
          "reasoning": false,
          "input": [
            "text"
          ],
          "contextWindow": 131072,
          "maxTokens": 8192
        }
      ]
    }
  },
  {
    "path": "agents.defaults.model",
    "value": {
      "primary": "verntrip-deepseek/deepseek-chat"
    }
  },
  {
    "path": "tools.profile",
    "value": "full"
  },
  {
    "path": "tools.allow",
    "value": [
      "verntrip_runtime_status",
      "verntrip_workspace_scope_read",
      "verntrip_tourism_catalog_read"
    ]
  }
]

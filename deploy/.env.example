# Image and port settings
APP_VERSION=latest
WEB_PORT=80
BACKEND_PORT=8080
POSTGRES_PORT=5432
OPENCLAW_VERSION=2026.7.1
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1
OPENCLAW_GATEWAY_PORT=18789
TZ=Asia/Shanghai

# Generated by scripts/docker/init-env.ps1
POSTGRES_USER=verntrip
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=verntrip
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-random-admin-password
OPENCLAW_GATEWAY_TOKEN=replace-with-a-random-gateway-token
VERNTRIP_OPENCLAW_SERVICE_TOKEN=replace-with-a-random-service-token

# Required model provider
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=180

# AMap browser and server credentials
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=
AMAP_WEB_SERVICE_KEY=
AMAP_WEB_SERVICE_TIMEOUT=8s
AMAP_DYNAMIC_CATALOG_ENABLED=true
AMAP_MINIMUM_CATALOG_SIZE=12
AMAP_POI_PAGE_SIZE=8

# Application runtime
ASSISTANT_ENGINE=openclaw
OPENCLAW_AGENT_ID=verntrip-main
OPENCLAW_TIMEOUT=180s
OPENCLAW_SESSION_CONTEXT_TTL=30m
AI_SERVICE_TIMEOUT=180s
USER_SESSION_TTL=12h
USER_AUTH_REQUIRED=true
RAG_PROFILE=tfidf_topk_basic
RAG_EMBEDDING_BACKEND=sentence_transformers
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_DEVICE=cpu
LOG_LEVEL=INFO
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8

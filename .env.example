SERVER_PORT=8080
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_ADMIN_PORT=5174
# 高德地图 Web（JS API）Key 与安全密钥；本地开发可直接配置，生产环境建议改用代理转发。
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=
# 高德 Web 服务 API Key，用于后端按城市动态补充 POI 资源。
AMAP_WEB_SERVICE_KEY=
AMAP_DYNAMIC_CATALOG_ENABLED=true
AMAP_MINIMUM_CATALOG_SIZE=12
AMAP_POI_PAGE_SIZE=8
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=180s
PAPER_UPLOAD_DIR=./storage/papers
WORKSPACE_ROOT_DIR=./storage/workspace
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
USER_SESSION_TTL=12h
USER_AUTH_REQUIRED=true
# Examples:
#   tfidf_topk_basic
#   bm25_mmr_basic
#   dense_pgvector_topk_basic
#   hybrid_pgvector_submodular_random_walk
RAG_PROFILE=tfidf_topk_basic
RAG_EMBEDDING_BACKEND=sentence_transformers
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_DEVICE=cpu
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
ASSISTANT_ENGINE=openclaw
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BASE_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=verntrip-main
OPENCLAW_TIMEOUT=180s
VERNTRIP_OPENCLAW_SERVICE_TOKEN=
OPENCLAW_SESSION_CONTEXT_TTL=30m
OPENCLAW_SHADOW_SAMPLE_RATE=1.0
OPENCLAW_SHADOW_TIMEOUT=60s
OPENCLAW_SHADOW_MAX_OUTPUT_TOKENS=2400
OPENCLAW_SHADOW_MAX_STORED_CHARS=12000
DB_URL=jdbc:h2:file:./data/vernflow;MODE=PostgreSQL;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver

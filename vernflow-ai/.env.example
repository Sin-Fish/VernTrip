# Preferred source: project root .env / .env.local
# Keep this file only for service-local overrides when needed.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
